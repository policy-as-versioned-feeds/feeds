{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://policy-as-versioned.dev/schema/feeds/threat-register-release-cage-v1.json",
  "title": "feeds threat-register payload, opt-in release cage v1",
  "description": "Source-only opt-in extension of payload.schema.v4.json. No existing payload selects this schema. Selecting a new payload_schema is a major change under the existing native ladder; the optional proof never edits authoritative values.",
  "type": "object",
  "required": [
    "feed_version",
    "published_by",
    "currency",
    "note",
    "institutions"
  ],
  "properties": {
    "feed_version": {
      "type": "string",
      "minLength": 1
    },
    "published_by": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code the loss magnitudes in this register are stated in. REQUIRED: a subscriber reading a magnitude with no declared currency would have to assume its own, which mints a currency instead of converting one (ADR-0020). Composition refuses a feed that declares none."
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "changelog": {
      "type": "string"
    },
    "institutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "threat",
          "flavour",
          "lef",
          "source",
          "lm_gbp",
          "lm_basis"
        ],
        "properties": {
          "threat": {
            "type": "string",
            "minLength": 1
          },
          "flavour": {
            "type": "string",
            "minLength": 1
          },
          "lef": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            },
            "description": "min, most-likely, max annual loss events."
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "lm_gbp": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0
            },
            "description": "min, most-likely, max IMPACT per loss event, in this payload's declared `currency`. lo <= mode <= hi."
          },
          "lm_basis": {
            "type": "object",
            "description": "What the magnitude rests on. A number the publisher signs and cannot say the source of is a missing instrument (ADR-0020), never a cheaper one.",
            "required": [
              "kind",
              "statement",
              "as_of"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "counted",
                  "published",
                  "editorial"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "could_not_look": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "lef_basis": {
            "type": "object",
            "description": "What the magnitude rests on. A number the publisher signs and cannot say the source of is a missing instrument (ADR-0020), never a cheaper one.",
            "required": [
              "kind",
              "statement",
              "as_of"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "counted",
                  "published",
                  "editorial"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "could_not_look": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "threats": {
            "type": "object",
            "description": "Named threats beyond the headline, keyed by a slug. Each publishes a frequency with its basis. The magnitude is the row's own (lm_gbp + lm_basis) or the subscriber's (magnitude_basis).",
            "additionalProperties": {
              "type": "object",
              "required": [
                "threat",
                "lef",
                "lef_basis"
              ],
              "additionalProperties": false,
              "properties": {
                "threat": {
                  "type": "string",
                  "minLength": 1
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "lef": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  },
                  "description": "min, most-likely, max annual loss events."
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "lef_basis": {
                  "type": "object",
                  "description": "What the magnitude rests on. A number the publisher signs and cannot say the source of is a missing instrument (ADR-0020), never a cheaper one.",
                  "required": [
                    "kind",
                    "statement",
                    "as_of"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "counted",
                        "published",
                        "editorial"
                      ]
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "could_not_look": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "lm_gbp": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "min, most-likely, max IMPACT per loss event, in this payload's declared `currency`. lo <= mode <= hi."
                },
                "lm_basis": {
                  "type": "object",
                  "description": "What the magnitude rests on. A number the publisher signs and cannot say the source of is a missing instrument (ADR-0020), never a cheaper one.",
                  "required": [
                    "kind",
                    "statement",
                    "as_of"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "counted",
                        "published",
                        "editorial"
                      ]
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "could_not_look": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "magnitude_basis": {
                  "type": "object",
                  "description": "Whose the magnitude is when this register publishes none for the row: `subscriber` means the subscriber derives it from its own signed prices (ticket 30 decision 12). A row carries lm_gbp with lm_basis, or magnitude_basis, never neither.",
                  "required": [
                    "kind",
                    "statement",
                    "as_of"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "subscriber"
                      ]
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "release_cage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
