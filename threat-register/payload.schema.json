{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://policy-as-versioned.dev/schema/feeds/threat-register.json",
  "title": "threat-register payload",
  "description": "Institution -> headline threat -> annual loss-event-frequency band. Derived from the shape platform/feeds/threat-register/v1,v2/register.json already published (ticket 21, ADR-0019). The entry map is `institutions`; rule.yaml names it as what an added or removed entry means.",
  "type": "object",
  "required": ["feed_version", "published_by", "note", "institutions"],
  "properties": {
    "feed_version": { "type": "string", "minLength": 1 },
    "published_by": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "changelog": { "type": "string" },
    "institutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["threat", "flavour", "lef", "source"],
        "properties": {
          "threat": { "type": "string", "minLength": 1 },
          "flavour": { "type": "string", "minLength": 1 },
          "lef": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" },
            "description": "min, most-likely, max annual loss events."
          },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
